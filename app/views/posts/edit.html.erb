<h1>つまずき編集</h1>
<% if @post.errors.any? %>
  <% @post.errors.full_messages.each do |message| %>
    <p><%= message %></p>
  <% end %>
<% end %>
<%= form_with model: @post do |f| %>
    <%= f.label :title %>
    <%= f.text_field :title %>
    <%= f.label :content %>
    <%= f.text_area :content %>
    <%= f.label :date %>
    <%= f.date_field :date %>
    <%= f.submit "更新する" %>
<% end %>