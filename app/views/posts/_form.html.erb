<%= form_with model: post do |f| %>
  <%= f.label :title %>
  <%= f.text_field :title %>

  <%= f.label :content %>
  <%= f.text_area :content %>

  <%= f.label :date %>
  <%= f.date_field :date %>

  <%= f.label :category %>
  <%= f.select :category, Post.categories.keys.map { |category| [category.titleize, category] } %>

  <%= f.label :tag_names %>
  <%= f.text_field :tag_names %>

  <%= f.submit post.persisted? ? "更新する" : "投稿する" %>
<% end %>
