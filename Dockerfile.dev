FROM ruby:3.3-bookworm

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential \
      git \
      libpq-dev \
      postgresql-client \
      libyaml-dev && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN gem install rails -v "~> 8.1.0" --no-document
