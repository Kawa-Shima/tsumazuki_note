<h1>つまずき一覧</h1>
<%= search_form_for @q, url: posts_path do |f| %>
  <%= f.label :title_i_cont, "タイトル" %>
  <%= f.text_field :title_i_cont %>
  <%= f.label :content_i_cont, "内容" %>
  <%= f.text_field :content_i_cont %>

  <%= f.label :category_eq, "カテゴリ" %>
  <%= f.select :category_eq, Post.categories.map { |name, value| [name.humanize, value] }, { include_blank: "すべて" } %>

  <%= f.label :tags_name_eq, "タグ" %>
  <%= f.select :tags_name_eq, @tag_names, { include_blank: "すべて" } %>

  <%= f.submit "検索" %>
<% end %>


<% if @posts.empty? %>
  <p>つまずきがありません。</p>
<% else %>
  <% @posts.each do |post| %>
   <p><%= link_to post.title, post_path(post) %></p>
   <p><%= post.date %></p>
   <p><%= post.status %></p>
  <% end %>
<% end %>

